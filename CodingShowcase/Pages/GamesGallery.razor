@page "/games"

<PageTitle>Games</PageTitle>
<Copy PageTitle="Games"></Copy>
<div class="gamesGallery">
    <div class="galleryHeader">Gallery</div>
    <div class="gameCard">
        <button @onclick="PreviousGame">
            <i class="fa fa-arrow-left"/>
        </button>
        <a href="@_games[_currentGame].Link">
            <img src="@_games[_currentGame].Image" alt="@_games[_currentGame].Alt"/>
        </a>
        <button @onclick="NextGame">
            <i class="fa fa-arrow-right"/>
        </button>
    </div>
</div>

@code {

    private List<GameCard> _games =
    [
        new("games/multiples", "images/2048_snapshot.png", "2048 Clone"),
        new("games/birdle", "images/birdle_snapshot.png", "Wordle but for birds")
    ];

    private int _currentGame;

    private void NextGame()
    {
        _currentGame = (_currentGame + _games.Count + 1) % _games.Count;
    }

    private void PreviousGame()
    {
        _currentGame = (_currentGame + _games.Count - 1) % _games.Count;
    }

    public class GameCard(string link, string image, string alt)
    {
        public string Link { get; set; } = link;
        public string Image { get; set; } = image;
        public string Alt { get; set; } = alt;
    }
}